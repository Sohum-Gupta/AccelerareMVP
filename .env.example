# Copy this file to .env and fill in real values. .env is git-ignored.
# Every variable the app reads is listed here.

# Django's signing key. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Hostnames the site may be served under, comma separated, no spaces.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection. These credentials match docker-compose.yml (added in a
# later step); they are for the local container only.
DATABASE_URL=postgres://accelerare:accelerare@localhost:5432/accelerare

# Sentry project DSN. Leave empty to disable error reporting (local and CI).
SENTRY_DSN=
