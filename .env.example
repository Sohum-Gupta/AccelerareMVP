# Copy this file to .env and fill in real values. .env is git-ignored.
# Every variable the app reads is listed here.

# Django's signing key. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Hostnames the site may be served under, comma separated, no spaces.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection. These credentials match docker-compose.yml (added in a
# later step); they are for the local container only.
DATABASE_URL=postgres://accelerare:accelerare@localhost:5432/accelerare

# Sentry project DSN. Leave empty to disable error reporting (local and CI).
SENTRY_DSN=

# Payments (Stripe). All optional: leave them empty and the buy pages say
# buying online is not open yet. Use TEST keys here (sk_test_..., whsec_...),
# from Stripe's dashboard in test mode; they take no real money.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# true adds Stripe's automatic sales tax to every purchase (set tax up in
# Stripe's dashboard first).
STRIPE_AUTOMATIC_TAX=false

# Outgoing email. Used by production only; local development prints emails to
# the terminal instead, so these can stay as they are on your Mac.
# Use an app-specific password, never the mailbox's real password.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Accelerare <noreply@example.com>
